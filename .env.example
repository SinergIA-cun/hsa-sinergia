DATABASE_URL="postgresql://hsa:hsa@localhost:5434/hsa?schema=public"
JWT_SECRET="cambia-esto-por-un-secreto-largo-de-verdad"

# Directorio de fotos de comprobante de pago (volumen persistente en prod)
COMPROBANTES_DIR="./data/comprobantes"

# API de solo lectura para el BI. Generar con: openssl rand -hex 32
# Si se deja vacía, /api/bi no existe.
BI_API_KEY=

# Llave APARTE para que el BI mande eventos (importar/conciliar). Es la única
# escritura del BI. Debe ser distinta de BI_API_KEY. Vacía = rutas inexistentes.
BI_IMPORT_API_KEY=

# Cuánto se guarda la bitácora forense, en días. Por omisión 1825 (5 años, lo que
# el SAT exige conservar). La poda corre al arrancar el contenedor: aquí no hay
# planificador, así que ese es el único momento en que puede pasar.
AUDITORIA_RETENCION_DIAS=1825
