generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DayType {
  viernes
  viernesEspecial
  sabado
  domAJue
}

enum AddOnKind {
  fijo
  porPersona
  porUnidad
}

enum UserRole {
  ventas
  admin
}

enum QuoteStatus {
  borrador
  enviada
  aceptada
  apartada
  formalizada
  liquidada
  vencida
}

enum PaymentMethod {
  efectivo
  transferencia
  tarjeta
}

enum PaymentConcept {
  anticipo
  complemento
  aCuenta
  finiquito
}

enum ActivityType {
  creada
  estatus
  pago
  pagoAnulado
  edicion
  eliminada
  restaurada
}

model PriceList {
  id           String        @id @default(cuid())
  anio         Int
  vigencia     DateTime?
  activa       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  rentalPrices RentalPrice[]
}

model Space {
  id           String             @id @default(cuid())
  nombre       String
  capacidadMax Int?
  activo       Boolean            @default(true)
  rentalPrices RentalPrice[]
  paymentRule  SpacePaymentRule?
}

model RentalPrice {
  id              String    @id @default(cuid())
  priceList       PriceList @relation(fields: [priceListId], references: [id])
  priceListId     String
  space           Space     @relation(fields: [spaceId], references: [id])
  spaceId         String
  min             Int
  max             Int?
  viernes         Int
  viernesEspecial Int
  sabado          Int
  domAJue         Int

  @@index([priceListId, spaceId])
}

model EventType {
  id           String        @id @default(cuid())
  nombre       String
  slug         String        @unique
  foodPackages FoodPackage[]
  quotes       Quote[]
}

model Client {
  id               String   @id @default(cuid())
  nombre           String
  telefono         String?
  correo           String?
  empresa          String?
  domicilio        String?
  identificacion   String?
  numeroReferencia Int      @unique @default(dbgenerated("nextval('client_ref_seq')"))
  createdAt        DateTime @default(now())
  quotes           Quote[]
}

model Quote {
  id            String      @id @default(cuid())
  client        Client      @relation(fields: [clientId], references: [id])
  clientId      String
  eventType     EventType   @relation(fields: [eventTypeId], references: [id])
  eventTypeId   String
  fechaEvento   DateTime
  horasEvento   Int?
  invitados     Int
  spaceIds      String[]
  horasExtra    Int         @default(0)
  foodPackageId String?
  addOns        Json        @default("[]")
  breakdown     Json
  total         Int
  rentaTotal    Int
  status        QuoteStatus @default(borrador)
  publicToken   String      @unique
  vigenciaHasta DateTime?
  createdBy     User?       @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  createdById   String?
  createdAt     DateTime    @default(now())
  horaInicio    String?
  horaTermino   String?
  horarioCivil  String?
  // Hoja operativa (datos ricos por evento: banquetero, equipo, personal, etc.).
  // JSON flexible para alimentar el documento interno, el correo diario y el ERP futuro.
  operativa     Json?
  deletedAt     DateTime?
  payments      Payment[]
  activityLog   ActivityLog[]

  @@index([clientId])
  @@index([status])
  @@index([createdById])
  @@index([fechaEvento])
  @@index([deletedAt])
}

model FoodPackage {
  id          String             @id @default(cuid())
  eventType   EventType          @relation(fields: [eventTypeId], references: [id])
  eventTypeId String
  nombre      String
  ivaIncluido Boolean            @default(false)
  incluye     String?
  brackets    FoodPackagePrice[]
}

model FoodPackagePrice {
  id             String      @id @default(cuid())
  package        FoodPackage @relation(fields: [packageId], references: [id])
  packageId      String
  min            Int
  max            Int?
  pricePerPerson Int
}

model AddOn {
  id     String    @id @default(cuid())
  nombre String
  kind   AddOnKind
  price  Int
  activo Boolean   @default(true)
}

model PricingConfig {
  id               String @id @default("default")
  ivaRate          Float  @default(0.16)
  extraHourRate    Float  @default(0.05)
  foodDiscountRate Float  @default(0.05)
  valetRatio       Float  @default(2.5)
}

model SpacePaymentRule {
  id                String @id @default(cuid())
  space             Space  @relation(fields: [spaceId], references: [id])
  spaceId           String @unique
  anticipo          Int
  complementoPct    Float
  liquidarDiasAntes Int    @default(30)
}

model Payment {
  id                   String         @id @default(cuid())
  quote                Quote          @relation(fields: [quoteId], references: [id])
  quoteId              String
  monto                Int
  metodo               PaymentMethod
  concepto             PaymentConcept
  fecha                DateTime
  referencia           String?
  folio                Int            @unique @default(dbgenerated("nextval('recibo_folio_seq')"))
  comprobanteKey       String?
  comprobanteMime      String?
  registradoBy         User?          @relation("PaymentRegistradoBy", fields: [registradoById], references: [id])
  registradoById       String?
  anuladoAt            DateTime?
  anuladoBy            User?          @relation("PaymentAnuladoBy", fields: [anuladoById], references: [id])
  anuladoById          String?
  motivoAnulacion      String?
  createdAt            DateTime       @default(now())

  @@index([quoteId])
}

model ActivityLog {
  id          String       @id @default(cuid())
  quote       Quote        @relation(fields: [quoteId], references: [id])
  quoteId     String
  tipo        ActivityType
  descripcion String
  meta        Json?
  actor       User?        @relation("ActivityActor", fields: [actorId], references: [id])
  actorId     String?
  createdAt   DateTime     @default(now())

  @@index([quoteId])
}

model User {
  id                  String        @id @default(cuid())
  nombre              String
  email               String        @unique
  passwordHash        String
  role                UserRole      @default(ventas)
  activo              Boolean       @default(true)
  createdAt           DateTime      @default(now())
  quotesCreated       Quote[]       @relation("QuoteCreatedBy")
  paymentsRegistrados Payment[]     @relation("PaymentRegistradoBy")
  paymentsAnulados    Payment[]     @relation("PaymentAnuladoBy")
  actividades         ActivityLog[] @relation("ActivityActor")
}
