generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DayType {
  viernes
  viernesEspecial
  sabado
  domAJue
}

enum AddOnKind {
  fijo
  porPersona
  porUnidad
}

enum UserRole {
  ventas
  admin
}

/// Los cuatro estatus que el negocio usa de verdad.
///
/// Se retiraron `enviada`, `aceptada` y `vencida` (punto 8, 13-ago-2026): nadie
/// los movía a mano, y `vencida` era además el ÚNICO mecanismo automático que
/// limpiaba la agenda. Al quitarlo, un borrador viejo sigue pintando su fecha
/// hasta que alguien lo manda a la papelera — consecuencia aceptada por el dueño.
enum QuoteStatus {
  borrador
  formalizada
  complementada
  liquidada
  /// Sin fecha: el cliente pospuso y no sabe cuándo. Suelta la fecha (no ocupa
  /// agenda ni disponibilidad), conserva su dinero y vuelve con "Reprogramar".
  standby
  /// Se canceló. Suelta la fecha. Lo pagado se devuelve en el porcentaje que se
  /// decidió al cancelar; lo demás se queda como retención.
  cancelada
}

/// Cómo entró el dinero. `tarjeta` es de antes de separar débito y crédito: se
/// conserva en los pagos viejos y ya no se ofrece. `mixto` = pago dividido en
/// varias formas; el detalle vive en la columna `formas` del pago.
enum PaymentMethod {
  efectivo
  transferencia
  tarjeta
  cheque
  tarjetaDebito
  tarjetaCredito
  mixto
}

enum PaymentConcept {
  anticipo
  complemento
  aCuenta
  finiquito
}

/// A qué va un pago. `evento` es la renta contratada (la de siempre: plan de
/// pagos, hitos y estatus). `cargos` es la cuenta del punto de venta: horas
/// extra, multas, invitados extra, gastos imprevistos. Esos pagos NO tocan el
/// plan ni el valor del evento.
enum PaymentDestino {
  evento
  cargos
}

/// Lo que se le puede cargar a la cuenta de un evento en el punto de venta.
enum ProductoCargo {
  horaExtra
  djHoraExtra
  invitadoExtra
  /// Los alimentos de los invitados extra, aparte de su renta: se le pagan al
  /// proveedor, y en el BI tienen que poder distinguirse de lo que cobra la hacienda.
  invitadoExtraAlimentos
  danos
  multa
  gastoImprevisto
  otro
}

enum ActivityType {
  creada
  estatus
  pago
  pagoAnulado
  edicion
  eliminada
  restaurada
  factura
  fiscal
  /// Un admin movió la cotización a otro catálogo (se represió a propósito).
  catalogo
  /// Se cargó algo a la cuenta del evento en el punto de venta.
  cargo
  /// Se anuló un cargo del punto de venta.
  cargoAnulado
  /// Se le devolvió dinero al cliente.
  devolucion
  /// Se anuló una devolución.
  devolucionAnulada
  /// El evento se canceló.
  cancelada
  /// El evento se puso en standby (sin fecha).
  standby
  /// El evento volvió de standby o de cancelado, o se reprogramó.
  reprogramada
}

/// El catálogo completo de un año: renta, servicios, alimentos y parámetros.
/// Una cotización queda casada a uno y recalcula SIEMPRE contra él, de modo que
/// cambiar el catálogo de este año nunca represia lo cotizado el año pasado.
model PriceList {
  id        String    @id @default(cuid())
  nombre    String    @unique // "2027", "2028"
  anio      Int
  vigencia  DateTime?
  activa    Boolean   @default(false)
  createdAt DateTime  @default(now())

  // Parámetros de precio. Vivían en el singleton PricingConfig, que era la
  // última fuente global capaz de represiar TODA cotización al reeditarla.
  ivaRate          Float @default(0.16)
  extraHourRate    Float @default(0.05)
  /// Personas extra antes de brincar de nivel: con 20, un evento de 110 o 120
  /// personas se cobra como el nivel de 100 más 10 o 20 personas a precio del
  /// nivel (renta: precio del nivel entre su tope; alimentos: su precio por
  /// persona). Con 121 ya se cobra el nivel siguiente. 0 = nunca (como antes).
  toleranciaExtras Int   @default(0)
  foodDiscountRate Float @default(0.05)
  capillaSabado    Int   @default(5000)

  rentalPrices RentalPrice[]
  addOns       AddOn[]
  foodPackages FoodPackage[]
  djPrices     DjHoraExtraPrice[]
  quotes       Quote[]
  auditoria    PriceListAudit[]
  /// Apartados con precio garantizado contra este catálogo.
  apartados    ApartadoFecha[]
}

/// Bitácora de cambios AL CONTENIDO de un catálogo. Separada de `ActivityLog`
/// porque esa exige `quoteId` y un cambio de catálogo no pertenece a ninguna
/// cotización — pertenece a todas las que cuelgan de él.
model PriceListAudit {
  id                   String    @id @default(cuid())
  priceList            PriceList @relation(fields: [priceListId], references: [id])
  priceListId          String
  /// "renta" | "servicio" | "paquete" | "dj" | "parametros"
  tipo                 String
  descripcion          String
  meta                 Json?
  actor                User?     @relation("PriceListAuditActor", fields: [actorId], references: [id])
  actorId              String?
  /// Cuántas cotizaciones estaban casadas a este catálogo AL MOMENTO del cambio.
  /// Se guarda el número entonces, no se recalcula después: es la medida real de
  /// lo que quien editó puso en riesgo, y cambiaría si se leyera hoy.
  cotizacionesEnRiesgo Int       @default(0)
  createdAt            DateTime  @default(now())

  @@index([priceListId, createdAt])
}

model Space {
  id           String            @id @default(cuid())
  nombre       String
  capacidadMax Int?
  activo       Boolean           @default(true)
  rentalPrices RentalPrice[]
  paymentRule  SpacePaymentRule?
}

model RentalPrice {
  id              String    @id @default(cuid())
  priceList       PriceList @relation(fields: [priceListId], references: [id])
  priceListId     String
  space           Space     @relation(fields: [spaceId], references: [id])
  spaceId         String
  min             Int
  max             Int?
  /// Los cuatro precios con IVA. `null` = no aplica: ese día no se ofrece. El
  /// viernes especial que no aplica se cobra como viernes normal (es promoción).
  viernes         Int?
  viernesEspecial Int?
  sabado          Int?
  domAJue         Int?
  /// "dia" = renta por tipo de día · "plano" = renta plana (Team Building).
  /// Antes vivía en PriceList, lo que obligaba a tener DOS listas por año y
  /// dejaba la plana fuera del filtro `activa`.
  tipo            String    @default("dia")

  @@index([priceListId, spaceId])
  @@index([priceListId, tipo])
}

model EventType {
  id           String             @id @default(cuid())
  nombre       String
  slug         String             @unique
  rentaPlana   Boolean            @default(false) // usa la renta plana (Team Building) en vez de la de por-día
  foodPackages FoodPackage[]
  /// El precio del DJ por hora extra, por catálogo. Vivía aquí como un `Int?`
  /// global: clonar el catálogo no lo subía y editarlo represiaba lo reeditado.
  djPrices     DjHoraExtraPrice[]
  quotes       Quote[]
  apartados    ApartadoFecha[]
}

/// Precio de la hora extra de DJ, por catálogo y por tipo de evento.
///
/// Vivía en `EventType.djHoraExtra`, que era un precio en pesos GLOBAL: clonar
/// el catálogo con +8% lo dejaba igual, y editarlo represiaba toda cotización
/// que se reeditara. La misma clase de bug que mató el catálogo versionado, que
/// se colaba por la puerta de atrás.
///
/// Es por tipo de evento porque el precio real difiere ($2,950 en boda, $2,750
/// en bautizo) y un tipo SIN renglón simplemente no ofrece el servicio (hoy:
/// graduación, renta y team building).
model DjHoraExtraPrice {
  id          String    @id @default(cuid())
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  priceListId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id])
  eventTypeId String
  price       Int

  @@unique([priceListId, eventTypeId])
}

// Banqueteros (proveedores de alimentos). Se elige uno en la hoja operativa para
// llevar registro de ventas por banquetero.
model Banquetero {
  id           String           @id @default(cuid())
  nombre       String
  /// OBLIGATORIO al dar de alta (lo exige el esquema de la API), pero la columna
  /// es nullable: a los banqueteros que ya existían sin teléfono no se les puede
  /// inventar uno, y rellenarlos sería peor —un teléfono falso se ve igual que
  /// uno real—. La ficha los marca como incompletos hasta que alguien capture el
  /// de verdad.
  telefono     String?
  /// Opcional. Sirve para mandarle su estado de cuenta sin depender de WhatsApp.
  correo       String?
  activo       Boolean          @default(true)
  /// Token del enlace de solo lectura de su estado de cuenta, mismo formato que
  /// `Quote.publicToken` (32 hex sin guiones). Es lo que mata el hilo de WhatsApp.
  ///
  /// El default lo pone POSTGRES y no la aplicación a propósito: hay seis lugares
  /// que crean banqueteros (seed, panel de admin, cuatro suites de prueba) y un
  /// token generado en código obliga a acordarse en todos. Con el default en la
  /// base, una fila SIN token no puede existir.
  ///
  /// VERIFICADO: a diferencia de los `nextval`, este `dbgenerated` **no** ensucia
  /// el diff — `migrate diff --from-migrations … --shadow-database-url` sale
  /// limpio salvo los dos `DROP SEQUENCE` de siempre. La migración
  /// `20260819190000_banquetero_public_token` dice lo contrario en un comentario:
  /// se escribió por precaución antes de comprobarlo y ya no se puede corregir
  /// sin invalidar su checksum en `_prisma_migrations`. Manda esto.
  publicToken  String           @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  createdAt    DateTime         @default(now())
  quotes       Quote[]
  /// Los depósitos a cuenta que ha hecho. El dinero entra a su cuenta y DESPUÉS
  /// se reparte entre sus eventos (decisión 3 del dueño).
  depositos    PagoBanquetero[]
  /// Las fechas que tiene apartadas sin cotización todavía.
  apartados    ApartadoFecha[]
  /// El saldo a favor que se le ha devuelto.
  devoluciones Devolucion[]
}

/// Un depósito del banquetero a la hacienda, ANTES de saber a qué eventos va.
///
/// El dinero llega antes que la instrucción de cómo repartirlo (decisión 3 del
/// dueño), así que el saldo sin asignar es un estado legítimo y visible.
///
/// Cada asignación genera un `Payment` REAL en la cotización, con su folio de
/// recibo: por eso el estado de cuenta, los hitos del plan, el candado de
/// facturación y el API del BI siguen funcionando sin cambiar una línea. Lo único
/// que gana el `Payment` es `pagoBanqueteroId`, la liga al depósito madre.
model PagoBanquetero {
  id              String          @id @default(cuid())
  banquetero      Banquetero      @relation(fields: [banqueteroId], references: [id])
  banqueteroId    String
  /// Folio de la serie `I`. El depósito es la entrada de dinero; los pagos que
  /// salen de repartirlo llevan este mismo folio. `null` = depósito de antes del
  /// folio (no se renumeró nada: decisión del dueño).
  folio           Int?            @default(dbgenerated("nextval('recibo_folio_seq')"))
  monto           Int
  metodo          PaymentMethod
  /// Partes del depósito si vino dividido. Ver `Payment.formas`.
  formas          Json?
  /// Cuándo se RECIBIÓ el dinero. Es la fecha que heredan los `Payment` de sus
  /// asignaciones, no la del reparto: el SAT exige facturar el ingreso en el mes
  /// en que se recibe, así que un depósito de marzo repartido en mayo sigue
  /// siendo ingreso de marzo para el candado del Plan C.
  fecha           DateTime
  referencia      String?
  /// Notas libres de quien registra: lo que ayude a entender este dinero ("pagó
  /// la tía", "el cheque se cobra el lunes"). Internas: el cliente no las ve.
  notas           String?
  comprobanteKey  String?
  comprobanteMime String?
  registradoBy    User?           @relation("PagoBanqueteroRegistradoBy", fields: [registradoById], references: [id])
  registradoById  String?
  anuladoAt       DateTime?
  /// Quién lo anuló. No estaba en el diseño y se agregó por simetría con
  /// `Payment`: anular un depósito es un movimiento de dinero de admin y sin esto
  /// quedaba el motivo pero no el responsable.
  anuladoBy       User?           @relation("PagoBanqueteroAnuladoBy", fields: [anuladoById], references: [id])
  anuladoById     String?
  motivoAnulacion String?
  createdAt       DateTime        @default(now())
  /// Los pagos por evento que salieron de este depósito.
  asignaciones    Payment[]
  /// Y los abonos a fechas apartadas que salieron de él. Cuentan contra el saldo
  /// sin asignar igual que las asignaciones, hasta que el apartado se convierte.
  abonosApartado  AbonoApartado[]
  /// Lo que se le devolvió al banquetero del saldo sin repartir de este depósito.
  devoluciones    Devolucion[]

  @@index([banqueteroId, fecha])
}

/// Una fecha apartada por un banquetero ANTES de que exista cotización o precio.
///
/// Existe por el caso 3 del dueño: los banqueteros son los que más graduaciones
/// venden, piden fechas muy adelantadas —hoy 2028— y pagan la fecha sin que los
/// precios existan todavía. Hoy eso no cabe: `createQuote` exige un catálogo y
/// calcula un total.
///
/// Bloquea la disponibilidad igual que un evento comprometido —es dinero real
/// sobre una fecha— pero NO tiene total: no es una venta cerrada y no debe entrar
/// a ningún reporte de ingreso comprometido.
model ApartadoFecha {
  id                String          @id @default(cuid())
  /// Quién apartó: un banquetero O un cliente directo, exactamente uno (CHECK en
  /// la migración `apartado_cliente_bi`). Hasta el 5-oct-2026 solo podía ser un
  /// banquetero; el BI trae fechas apartadas por clientes directos.
  banquetero        Banquetero?     @relation(fields: [banqueteroId], references: [id], onDelete: Restrict)
  banqueteroId      String?
  client            Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientId          String?
  /// El precio que ya se pactó por la fecha, en pesos enteros, si lo hay. No es
  /// un total calculado: un apartado sigue sin pasar por el motor de precios.
  /// Se enseña al convertir para que no se pierda.
  precioAcordado    Int?
  /// El tipo de evento, si ya se sabe. Solo prellena la conversión.
  eventType         EventType?      @relation(fields: [eventTypeId], references: [id])
  eventTypeId       String?
  /// El `idBI` con el que llegó del BI. Llave de idempotencia de la importación.
  importadoBI       String?         @unique
  fechaEvento       DateTime
  spaceIds          String[]
  /// Catálogo al que se le garantizó el precio, si se negoció uno. Es el tramo 1
  /// del Plan E cobrando: se clona 2027 con el incremento negociado y se amarra el
  /// apartado a ese catálogo, así el banquetero no paga a ciegas.
  priceList         PriceList?      @relation(fields: [priceListId], references: [id])
  priceListId       String?
  /// El dinero que ha entrado a esta fecha, abono por abono.
  ///
  /// Antes era UNA columna `deposito` con su método y su fecha. Un solo número no
  /// aguanta lo que hace un banquetero: pedir 2029 y abonar de a poco durante dos
  /// años. O se pisaba el monto anterior —y con él la fecha en que entró cada
  /// peso, que es lo que el SAT mira— o no se registraba.
  abonos            AbonoApartado[]
  /// Vence. Sin esto apartan 2029 gratis y se pierde inventario de fechas buenas.
  vence             DateTime
  nota              String?
  /// La cotización que nació de este apartado, al convertirlo. Mientras es `null`
  /// el apartado es lo que bloquea la fecha; en cuanto existe, la que bloquea es
  /// la cotización y el apartado deja de contar (si no, se contaría doble y el
  /// evento convertido choocaría con su propio apartado).
  quote             Quote?          @relation(fields: [quoteId], references: [id])
  quoteId           String?         @unique
  /// Quién lo apartó y quién lo canceló. No estaban en el diseño: `ActivityLog`
  /// exige `quoteId` y un apartado no pertenece a ninguna cotización, así que la
  /// fila es su propia bitácora y sin el actor no sirve de rastro.
  createdBy         User?           @relation("ApartadoCreatedBy", fields: [createdById], references: [id])
  createdById       String?
  canceladoAt       DateTime?
  canceladoBy       User?           @relation("ApartadoCanceladoBy", fields: [canceladoById], references: [id])
  canceladoById     String?
  motivoCancelacion String?
  createdAt         DateTime        @default(now())

  @@index([fechaEvento])
  @@index([banqueteroId])
  @@index([clientId])
}

// Personal HSA: catálogo de empleados y cuadrillas (grupos) para armar la hoja
// operativa de cada evento eligiendo una cuadrilla y ajustando horarios.
/// Una entrada de dinero sobre una fecha apartada.
///
/// Un apartado NO tiene precio —2029 no tiene catálogo, ni PAX, ni tipo de
/// evento— así que esto no es "abonar a una deuda": es dinero a favor de esa
/// fecha. El total aparece cuando el apartado se vuelve cotización, y entonces
/// cada abono se convierte en un `Payment` **con su propia fecha de recepción**.
model AbonoApartado {
  id               String          @id @default(cuid())
  /// Cascade: el abono no significa nada sin su apartado.
  apartado         ApartadoFecha   @relation(fields: [apartadoId], references: [id], onDelete: Cascade)
  apartadoId       String
  /// Folio de la serie `I` si el abono fue dinero que ENTRÓ (abono directo). Si
  /// salió del saldo de un depósito lleva el folio de ese depósito: no es dinero
  /// nuevo. `null` = abono de antes del folio.
  folio            Int?            @default(dbgenerated("nextval('recibo_folio_seq')"))
  /// Su letra si salió de un depósito (`I 5340-C`). Ver `Payment.folioLetra`.
  folioLetra       String?
  monto            Int
  metodo           PaymentMethod
  /// Partes del abono si vino dividido. Ver `Payment.formas`.
  formas           Json?
  /// Cuándo se RECIBIÓ el dinero, no cuándo se capturó ni cuándo se convierte.
  /// Es la fecha que hereda el `Payment` al convertir: el ingreso se factura en el
  /// mes en que entró.
  fecha            DateTime
  referencia       String?
  /// Notas libres de quien registra: lo que ayude a entender este dinero ("pagó
  /// la tía", "el cheque se cobra el lunes"). Internas: el cliente no las ve.
  notas            String?
  comprobanteKey   String?
  comprobanteMime  String?
  /// Si salió del saldo a favor del banquetero, de qué depósito. `null` = pago
  /// directo a esta fecha.
  pagoBanquetero   PagoBanquetero? @relation(fields: [pagoBanqueteroId], references: [id])
  pagoBanqueteroId String?
  /// El pago que nació de este abono al convertir el apartado.
  ///
  /// No es decorativo: mientras es `null`, el abono cuenta contra el saldo sin
  /// asignar de su depósito; en cuanto existe, el que cuenta es el `Payment`. Sin
  /// este puntero el mismo dinero se restaría dos veces.
  payment          Payment?        @relation(fields: [paymentId], references: [id])
  paymentId        String?         @unique
  registradoBy     User?           @relation("AbonoApartadoRegistradoBy", fields: [registradoById], references: [id])
  registradoById   String?
  anuladoAt        DateTime?
  anuladoBy        User?           @relation("AbonoApartadoAnuladoBy", fields: [anuladoById], references: [id])
  anuladoById      String?
  motivoAnulacion  String?
  createdAt        DateTime        @default(now())

  @@index([apartadoId])
  @@index([pagoBanqueteroId])
}

model Empleado {
  id         String             @id @default(cuid())
  nombre     String
  rol        String? // rol por defecto (p. ej. "Comodín", "Jefe de área")
  activo     Boolean            @default(true)
  createdAt  DateTime           @default(now())
  cuadrillas CuadrillaMiembro[]
}

model Cuadrilla {
  id        String             @id @default(cuid())
  nombre    String
  activo    Boolean            @default(true)
  createdAt DateTime           @default(now())
  miembros  CuadrillaMiembro[]
}

model CuadrillaMiembro {
  id          String    @id @default(cuid())
  cuadrilla   Cuadrilla @relation(fields: [cuadrillaId], references: [id], onDelete: Cascade)
  cuadrillaId String
  empleado    Empleado  @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  empleadoId  String

  @@unique([cuadrillaId, empleadoId])
  @@index([cuadrillaId])
  @@index([empleadoId])
}

model Client {
  id                String   @id @default(cuid())
  nombre            String
  telefono          String?
  correo            String?
  empresa           String?
  domicilio         String?
  identificacion    String?
  numeroReferencia  Int      @unique @default(dbgenerated("nextval('client_ref_seq')"))
  // Datos fiscales (CFDI 4.0). Opcionales: se capturan solo si el cliente
  // pide factura, y se reutilizan en todos sus eventos.
  rfc               String?
  razonSocial       String? // nombre fiscal exacto, SIN régimen societario
  regimenFiscal     String? // clave SAT: 601, 612, 626…
  cpFiscal          String? // 5 dígitos del domicilio fiscal
  usoCfdi           String? // clave SAT: G03, S01…
  correoFacturacion String?
  csfKey            String? // Constancia de Situación Fiscal adjunta
  csfMime           String?
  createdAt         DateTime @default(now())
  quotes            Quote[]
  apartados         ApartadoFecha[]
}

model Quote {
  id                  String            @id @default(cuid())
  client              Client            @relation(fields: [clientId], references: [id])
  clientId            String
  eventType           EventType         @relation(fields: [eventTypeId], references: [id])
  eventTypeId         String
  fechaEvento         DateTime
  horasEvento         Int?
  invitados           Int
  spaceIds            String[]
  horasExtra          Int               @default(0)
  foodPackageId       String?
  addOns              Json              @default("[]")
  breakdown           Json
  total               Int
  rentaTotal          Int
  status              QuoteStatus       @default(borrador)
  /// **El folio: la llave interna que no cambia.** `27SEP-0184` — año y mes en
  /// que se contrató, más un consecutivo. Lo asigna POSTGRES (`folio_evento()`):
  /// una fila sin folio no puede existir y dos altas simultáneas no chocan. La app
  /// nunca lo escribe ni lo cambia. Ya no es lo que se enseña primero: ver abajo.
  folio               String            @unique @default(dbgenerated("folio_evento()"))
  /// **El código: el identificador principal.** `04SEP26-HLANGRUEN-CUPULA` —
  /// día, mes, año, inicial + apellido del cliente y el salón.
  ///
  /// Es el que la operación usa de siempre, el que se ve primero en pantalla, en
  /// el recibo y en el BI (decisión del dueño, 1-oct-2026). Como describe el
  /// evento, se recalcula cuando cambia la fecha, el salón o el cliente —también
  /// ya formalizado— y cada cambio queda en `CodigoEvento`. Dos eventos vivos no
  /// lo comparten: el segundo lleva sufijo (`-2`). Ver `quotes/codigo.ts`.
  etiqueta            String?
  publicToken         String            @unique
  vigenciaHasta       DateTime?
  usaCapilla          Boolean           @default(false) // cortesía; $5,000 en sábado. Varios eventos pueden usarla el mismo día.
  capillaHorario      String? // horario de la capilla para este evento (varios eventos comparten el día).
  esCortesia          Boolean           @default(false) // cortesía familiar: se marca verde en la agenda.
  /// Descuento / promoción: el mismo descuento que la cortesía (`descuentoPct`,
  /// solo sobre la renta del local) pero sin marcar el evento en la agenda. Es
  /// una u otra: el formulario no deja marcar las dos.
  esPromocion         Boolean           @default(false)
  /// Descuento de cortesía, en por ciento (0..100). Pega SOLO sobre la renta, y
  /// lo hace CAMBIANDO SU PRECIO: las horas extra y el descuento del 5% por
  /// alimentos se calculan sobre el precio ya descontado. La capilla nunca se
  /// descuenta. Alimentos y servicios se cobran completos. Con 100% la renta queda
  /// en cero (más la capilla, si la hay). `null` = sin descuento, que es como se
  /// comportó `esCortesia` desde siempre (se guardaba, pero el motor nunca la leyó).
  descuentoPct        Float?
  /// Motivo del descuento. Es OBLIGATORIO cuando hay descuento —lo exige el
  /// esquema de crear/editar—, pero la columna es nullable porque la enorme
  /// mayoría de las cotizaciones no lleva descuento.
  descuentoMotivo     String?
  /// El estatus que tenía antes de ponerse en standby o cancelarse. Es al que
  /// vuelve al reprogramarse (y de ahí sube si los pagos ya dan para más).
  statusPrevio        QuoteStatus?
  /// Desde cuándo y por qué está en standby. `fechaEvento` se conserva como la
  /// fecha que tenía, pero ya no ocupa la agenda.
  standbyDesde        DateTime?
  standbyMotivo       String?
  /// La cancelación: cuándo, por qué y qué se decidió hacer con el dinero.
  canceladaAt         DateTime?
  cancelacionMotivo   String?
  /// Porcentaje de lo pagado que se le devuelve (0..100). El resto se retiene.
  cancelacionPct      Float?
  /// Lo pagado al cancelar y lo que de eso se acordó devolver, en pesos. Se
  /// guardan porque lo pagado puede cambiar después (una devolución, un pago
  /// anulado) y el acuerdo es el de ese día.
  cancelacionPagado   Int?
  cancelacionDevolver Int?
  usaDjHoraExtra      Boolean           @default(false) // DJ por hora extra (precio según tipo de evento).
  requiereFactura     Boolean           @default(false) // este cliente pidió factura para ESTE evento.
  banquetero          Banquetero?       @relation(fields: [banqueteroId], references: [id])
  /// El banquetero de este evento. Con banquetero, ÉL es el cliente de la
  /// hacienda: firma él y se le factura a él (decisión del dueño en el diseño de
  /// banqueteros). El festejado de abajo es el cliente final, y es dato operativo.
  banqueteroId        String?
  /// Nombre del festejado (el cliente FINAL cuando el evento lo compra un
  /// banquetero, y de paso el homenajeado de cualquier evento).
  ///
  /// Es dato OPERATIVO: va en la hoja operativa y **no** en el contrato — el
  /// contrato y la factura leen al cliente, que es quien firma. La hacienda no se
  /// mete en la reventa.
  ///
  /// Convive con `operativa.hoja.nombreFestejado`, que es donde se capturaba
  /// antes al llenar la hoja: esta columna es la que se captura al COTIZAR y manda
  /// sobre la de la hoja, que queda como respaldo de los eventos anteriores.
  festejado           String?
  festejadoTelefono   String?
  createdBy           User?             @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  createdById         String?
  createdAt           DateTime          @default(now())
  horaInicio          String?
  horaTermino         String?
  horarioCivil        String?
  // Hoja operativa (datos ricos por evento: banquetero, equipo, personal, etc.).
  // JSON flexible para alimentar el documento interno, el correo diario y el ERP futuro.
  operativa           Json?
  deletedAt           DateTime?
  /// Catálogo con el que se coteó. MANDA al recalcular: reeditar una cotización
  /// de 2027 usa precios de 2027 aunque el catálogo activo ya sea 2028.
  priceList           PriceList         @relation(fields: [priceListId], references: [id])
  priceListId         String
  payments            Payment[]
  activityLog         ActivityLog[]
  extras              QuoteExtra[]
  /// La cuenta del punto de venta: lo que se agregó después de contratar.
  cargos              CargoEvento[]
  /// El dinero que se le devolvió al cliente de este evento.
  devoluciones        Devolucion[]
  /// El id del evento en el BI, si vino de ahí (o se ligó a uno). Es la llave de
  /// la importación: mandar el mismo evento dos veces no lo duplica.
  ///
  /// Un evento importado tiene PRECIO PACTADO: su desglose son los montos del BI
  /// y editarlo nunca lo recotiza contra el catálogo (se vendió a ese precio).
  importadoBI         String?           @unique
  /// Cuándo se contrató, si no fue aquí. Los importados se vendieron antes de que
  /// existiera el sistema, así que `createdAt` es la fecha de la importación.
  contratadoEl        DateTime?
  /// El apartado del que nació, si nació de uno.
  apartado            ApartadoFecha?
  /// Las fotos del evento una vez pasada su fecha (una por versión).
  historico           EventoHistorico[]
  /// Todos los códigos que ha tenido, empezando por el de su alta. El vigente es
  /// `etiqueta`; aquí queda el rastro de cada cambio de fecha, salón o cliente.
  codigos             CodigoEvento[]

  @@index([clientId])
  @@index([status])
  @@index([createdById])
  @@index([fechaEvento])
  @@index([deletedAt])
  @@index([banqueteroId])
  @@index([priceListId])
}

/// Servicio suelto de UN evento, fuera del catálogo. Ej.: el proveedor de comida
/// cobra $200 más por persona por cambio de menú, solo para este evento.
///
/// NO es un add-on del catálogo, y es importante que no lo sea: por eso guarda el
/// nombre y el monto COPIADOS y no un id. Así no sufre el problema de "resolver vs
/// ofrecer" que costó dos bugs (el valet y La Capilla) — vive en la cotización, no
/// en un catálogo que puede cambiar bajo sus pies.
///
/// El monto SIEMPRE trae IVA incluido (decisión del dueño): lo teclado es lo final.
/// Va al grupo `otros` del desglose, así que NO entra a la base del complemento
/// ni a la del descuento de cortesía.
model QuoteExtra {
  id       String    @id @default(cuid())
  /// Cascade: la cotización es la dueña del renglón y no tiene sentido sin ella.
  /// Sin esto, borrar una cotización (o limpiar la base de pruebas) truena por FK.
  quote    Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId  String
  nombre   String
  kind     AddOnKind // fijo | porPersona | porUnidad
  monto    Int
  cantidad Int       @default(1) // solo se usa en porUnidad

  @@index([quoteId])
}

model FoodPackage {
  id          String             @id @default(cuid())
  eventType   EventType          @relation(fields: [eventTypeId], references: [id])
  eventTypeId String
  nombre      String
  ivaIncluido Boolean            @default(false)
  incluye     String?
  priceList   PriceList          @relation(fields: [priceListId], references: [id])
  priceListId String
  brackets    FoodPackagePrice[]

  @@index([priceListId])
}

model FoodPackagePrice {
  id             String      @id @default(cuid())
  package        FoodPackage @relation(fields: [packageId], references: [id])
  packageId      String
  min            Int
  max            Int?
  pricePerPerson Int
}

model AddOn {
  id          String    @id @default(cuid())
  nombre      String
  /// Para agruparlos al cotizar ("Mobiliario", "Iluminación", "Bebidas"…). Texto
  /// libre que pone el admin; `null` = sin categoría. Son muchos servicios y una
  /// sola lista plana ya no se podía recorrer.
  categoria   String?
  kind        AddOnKind
  price       Int
  activo      Boolean   @default(true)
  priceList   PriceList @relation(fields: [priceListId], references: [id])
  priceListId String

  @@index([priceListId])
}

model SpacePaymentRule {
  id                String @id @default(cuid())
  space             Space  @relation(fields: [spaceId], references: [id])
  spaceId           String @unique
  anticipo          Int
  complementoPct    Float
  liquidarDiasAntes Int    @default(30)
}

model Payment {
  id               String          @id @default(cuid())
  quote            Quote           @relation(fields: [quoteId], references: [id])
  quoteId          String
  monto            Int
  metodo           PaymentMethod
  /// Concepto EFECTIVO del pago: el que se DEDUCE de dónde deja el acumulado
  /// contra los hitos del plan (`packages/shared/src/pagos/concepto.ts`). No es
  /// lo que se teclea: se recalcula al registrar, al anular y al corregirlo a
  /// mano, porque anular un pago cambia el acumulado y con él el concepto de los
  /// pagos POSTERIORES.
  concepto         PaymentConcept
  /// El concepto que alguien capturó o corrigió A MANO, para poder discrepar de
  /// la deducción. `null` = nadie discrepó.
  ///
  /// Se guarda aparte de `concepto` a propósito: así la reclasificación en
  /// cadena puede reescribir el efectivo sin borrar la corrección de nadie, y la
  /// interfaz puede enseñar los dos y explicar la diferencia.
  ///
  /// La regla del finiquito gana SIEMPRE sobre esto (decisión del dueño): la
  /// etiqueta de finiquito la manda el saldo, no la captura.
  conceptoManual   PaymentConcept?
  fecha            DateTime
  referencia       String?
  /// Notas libres de quien registra: lo que ayude a entender este dinero ("pagó
  /// la tía", "el cheque se cobra el lunes"). Internas: el cliente no las ve.
  notas            String?
  /// Folio de la serie `I`: el número de la hoja foliada del dinero que entró.
  ///
  /// Ya NO es único: un folio es UNA entrada de dinero, y un depósito de
  /// banquetero repartido entre tres eventos es una sola entrada que genera tres
  /// pagos. Los tres llevan el folio del depósito. La unicidad la da la secuencia
  /// `recibo_folio_seq`, que es la misma para pagos, depósitos y abonos.
  folio            Int             @default(dbgenerated("nextval('recibo_folio_seq')"))
  /// La letra de este pago dentro de su depósito (`I 5340-B`): un depósito
  /// repartido es un solo folio y cada evento al que se aplica lleva su letra, en
  /// orden. `null` = pago directo, o aplicación de antes de las letras.
  folioLetra       String?
  /// El id del pago en el BI, si vino de una importación.
  importadoBI      String?
  /// A qué va: la renta del evento o su cuenta de cargos. Ver `PaymentDestino`.
  destino          PaymentDestino  @default(evento)
  /// Las partes de un pago dividido (`[{ forma, monto }]`, suman `monto`). `null`
  /// en los pagos de antes de la división: su única forma es `metodo`.
  formas           Json?
  // Candado de facturación (ver docs del Plan C). El ingreso se factura en el mes
  // en que se recibe; pasado ese mes se va a la global de público en general.
  facturadoAt      DateTime?
  facturaUuid      String?
  desbloqueoAt     DateTime?
  comprobanteKey   String?
  comprobanteMime  String?
  registradoBy     User?           @relation("PaymentRegistradoBy", fields: [registradoById], references: [id])
  registradoById   String?
  anuladoAt        DateTime?
  anuladoBy        User?           @relation("PaymentAnuladoBy", fields: [anuladoById], references: [id])
  anuladoById      String?
  motivoAnulacion  String?
  /// El depósito del banquetero del que salió este pago, si nació de una
  /// asignación. `null` = pago capturado directo en la cotización, que es el
  /// camino de siempre.
  pagoBanquetero   PagoBanquetero? @relation(fields: [pagoBanqueteroId], references: [id])
  pagoBanqueteroId String?
  /// El abono de un apartado del que nació este pago, si nació de uno.
  abonoApartado    AbonoApartado?
  createdAt        DateTime        @default(now())

  @@index([quoteId])
  @@index([pagoBanqueteroId])
  @@index([folio])
}

model ActivityLog {
  id          String       @id @default(cuid())
  quote       Quote        @relation(fields: [quoteId], references: [id])
  quoteId     String
  tipo        ActivityType
  descripcion String
  meta        Json?
  actor       User?        @relation("ActivityActor", fields: [actorId], references: [id])
  actorId     String?
  createdAt   DateTime     @default(now())

  @@index([quoteId])
}

model User {
  id                        String           @id @default(cuid())
  nombre                    String
  email                     String           @unique
  passwordHash              String
  role                      UserRole         @default(ventas)
  activo                    Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  /// Última vez que ESTE usuario abrió la papelera. El contador rojo son las
  /// cotizaciones que él puede ver con `deletedAt` posterior a este sello.
  /// Va en el usuario y no en la cotización a propósito: "sin ver" es una
  /// propiedad de quien mira, no de la cotización — dos personas pueden tener
  /// pendiente de ver la misma, y una la ve sin que la otra deje de verla.
  /// `null` = nunca la ha abierto: toda su papelera cuenta.
  papeleraVistaAt           DateTime?
  quotesCreated             Quote[]          @relation("QuoteCreatedBy")
  paymentsRegistrados       Payment[]        @relation("PaymentRegistradoBy")
  paymentsAnulados          Payment[]        @relation("PaymentAnuladoBy")
  abonosApartadoRegistrados AbonoApartado[]  @relation("AbonoApartadoRegistradoBy")
  abonosApartadoAnulados    AbonoApartado[]  @relation("AbonoApartadoAnuladoBy")
  depositosRegistrados      PagoBanquetero[] @relation("PagoBanqueteroRegistradoBy")
  depositosAnulados         PagoBanquetero[] @relation("PagoBanqueteroAnuladoBy")
  apartadosCreados          ApartadoFecha[]  @relation("ApartadoCreatedBy")
  apartadosCancelados       ApartadoFecha[]  @relation("ApartadoCanceladoBy")
  actividades               ActivityLog[]    @relation("ActivityActor")
  priceListAudits           PriceListAudit[] @relation("PriceListAuditActor")
  cambiosFolio              CambioFolio[]    @relation("CambioFolioActor")
  codigosEvento             CodigoEvento[]   @relation("CodigoEventoActor")
  cargosRegistrados         CargoEvento[]    @relation("CargoRegistradoBy")
  cargosAnulados            CargoEvento[]    @relation("CargoAnuladoBy")
  devolucionesRegistradas   Devolucion[]     @relation("DevolucionRegistradaBy")
  devolucionesAnuladas      Devolucion[]     @relation("DevolucionAnuladaBy")
}

/// La bitácora forense: quién tocó qué fila, con el contenido antes y después.
///
/// NO la escribe la aplicación. La escriben triggers de Postgres, así que
/// registra el cambio venga de donde venga —la API, psql, una migración, la
/// consola del proveedor—. Está aquí para poder LEERLA desde la app; ningún
/// código debe insertar, actualizar ni borrar en ella (un trigger de solo
/// escritura lo impide, y la purga por retención es la única excepción).
///
/// Convive con `ActivityLog` a propósito: aquella es la narrativa que lee el
/// equipo ("Estatus: borrador → formalizada"), ésta es la forense que lee quien
/// investiga algo raro. Sirven a preguntas distintas.
model AuditoriaDb {
  id          BigInt   @id @default(autoincrement())
  tabla       String
  /// INSERT | UPDATE | DELETE | TRUNCATE
  operacion   String
  /// La PK de la fila afectada. `null` en TRUNCATE, que no tiene filas.
  registroId  String?
  antes       Json?
  despues     Json?
  /// Los valores por omisión los pone Postgres y el trigger NO los manda. Hay que
  /// declararlos aquí o `prisma migrate dev` genera un `DROP DEFAULT` para ellos,
  /// y a partir de ahí cada escritura de la app truena por NOT NULL.
  usuarioDb   String   @default(dbgenerated("CURRENT_USER"))
  aplicacion  String?
  direccionIp String?
  /// Quién es la persona, sellado por la API dentro de su transacción.
  /// **`null` significa que el cambio NO vino de la app** — es la alarma.
  actorId     String?
  txid        String   @default(dbgenerated("(txid_current())::text"))
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([tabla, createdAt(sort: Desc)])
  @@index([registroId])
}

/// La foto de un evento cuya fecha ya pasó.
///
/// Existe porque un evento pasado deja de ser una previsión y se vuelve un
/// hecho, y los hechos no se recalculan. La cotización viva sigue ahí —los pagos
/// se siguen registrando hasta liquidar— pero el desglose, los nombres de los
/// espacios, los datos fiscales de entonces y la hoja operativa quedan copiados
/// aquí, **resueltos y por nombre**: la foto tiene que ser legible en diez años
/// sin las tablas vivas.
///
/// Es de solo agregar. Una corrección posterior escribe una VERSIÓN NUEVA, nunca
/// encima. Y solo se escribe cuando el contenido de verdad cambió: una lista de
/// versiones idénticas esconde las que sí importan.
model EventoHistorico {
  id          String   @id @default(cuid())
  quote       Quote    @relation(fields: [quoteId], references: [id])
  quoteId     String
  version     Int
  /// Por qué se tomó: `archivado` (la primera) o `actualizada`.
  motivo      String
  fechaEvento DateTime
  /// El folio del evento retratado. Es la liga estable entre todas sus fotos.
  folio       String?
  /// Cómo se describía el evento cuando se tomó ESTA foto.
  etiqueta    String?
  /// Todo lo demás, aplanado. Ver `FotoEvento` en `apps/api/src/historico/foto.ts`.
  foto        Json
  // --- Campos desnormalizados: existen para BUSCAR y ORDENAR sin abrir el json ---
  cliente     String
  banquetero  String?
  eventoTipo  String
  espacios    String[]
  total       Int
  pagado      Int
  saldo       Int
  /// ¿Llegó a apartar la fecha? `false` = quedó en borrador y el evento no se dio.
  seRealizo   Boolean
  liquidado   Boolean
  /// `cliente + código + banquetero + espacios`, en minúsculas y sin acentos.
  /// Se guarda calculado para que buscar "munoz" encuentre "Muñoz" sin pedirle a
  /// Postgres una extensión que este despliegue no tiene.
  busqueda    String
  createdAt   DateTime @default(now())

  @@unique([quoteId, version])
  @@index([fechaEvento(sort: Desc)])
  @@index([busqueda])
}

/// Cada código que ha tenido un evento (`04SEP26-HLANGRUEN-CUPULA`).
///
/// El código es la identidad que se usa en la operación: es el principal en la
/// pantalla, en el recibo y en el BI. Como describe el evento, cambia cuando se
/// mueve de fecha o de salón; cada cambio deja aquí un renglón, así que un código
/// viejo impreso en un papel siempre lleva al evento de hoy.
model CodigoEvento {
  id          String   @id @default(cuid())
  /// Cascade: sin el evento el rastro no significa nada (solo se borran de verdad
  /// los borradores de la papelera).
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     String
  codigo      String
  /// Qué lo cambió: `alta`, `fecha`, `espacio`, `cliente`, o `repetido` (otro
  /// evento ya tenía ese código y se le puso sufijo).
  motivos     String[]
  /// La fecha y los espacios con los que se armó este código.
  fechaEvento DateTime
  spaceIds    String[]
  /// SetNull: el rastro sobrevive a que se borre el usuario.
  actor       User?    @relation("CodigoEventoActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?
  createdAt   DateTime @default(now())

  @@index([quoteId, createdAt])
  @@index([codigo])
}

/// Cada vez que un admin fija el folio con el que arranca la numeración.
///
/// El folio lo lleva una secuencia de Postgres y un `setval` no deja rastro en la
/// bitácora forense (no es un cambio de fila). Esta tabla es ese rastro.
model CambioFolio {
  id        String   @id @default(cuid())
  /// El número que llevará el siguiente dinero que entre.
  siguiente Int
  /// El que iba a llevar antes del cambio.
  anterior  Int
  /// SetNull: el rastro sobrevive a que se borre el usuario (sin esto, borrar a
  /// un admin que alguna vez fijó el folio tronaría por la llave foránea).
  actor     User?    @relation("CambioFolioActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  createdAt DateTime @default(now())
}

/// Un renglón de la cuenta del evento en el punto de venta.
///
/// Es lo que se agrega DESPUÉS de contratar —casi siempre durante o después del
/// evento—: "quieren extender dos horas", "rompieron una mesa", "metieron cinco
/// invitados de más". NO cambia el valor del evento (`Quote.total` y el plan de
/// pagos quedan como se firmaron); es una venta aparte, casada al evento, con
/// sus propios pagos (`Payment.destino = cargos`).
///
/// El precio se COPIA al renglón, igual que `QuoteExtra`: cambiar mañana el 5%
/// de la hora extra no debe mover lo que ya se cobró.
model CargoEvento {
  id              String        @id @default(cuid())
  quote           Quote         @relation(fields: [quoteId], references: [id])
  quoteId         String
  producto        ProductoCargo
  /// Lo que se imprime: "Hora extra de salón", "Rompieron una mesa", etc.
  descripcion     String
  cantidad        Int
  /// Con IVA incluido: lo que se teclea es lo que se cobra.
  precioUnitario  Int
  total           Int
  /// El día de la venta (medianoche UTC, como `Payment.fecha`).
  fecha           DateTime
  registradoBy    User?         @relation("CargoRegistradoBy", fields: [registradoById], references: [id])
  registradoById  String?
  anuladoAt       DateTime?
  anuladoBy       User?         @relation("CargoAnuladoBy", fields: [anuladoById], references: [id])
  anuladoById     String?
  motivoAnulacion String?
  createdAt       DateTime      @default(now())

  @@index([quoteId])
  @@index([fecha])
}

/// Dinero que la hacienda DEVUELVE: "si un cliente pagó de más, poder devolverle
/// y que se marque" (el dueño).
///
/// Es de uno de dos lados, nunca de los dos:
///  - **De un evento** (`quoteId`): a la renta (`destino = evento`) o a la cuenta
///    del punto de venta (`destino = cargos`). Resta de lo pagado de ese lado.
///  - **De un banquetero** (`banqueteroId`): de su saldo a favor. Si sale del saldo
///    sin repartir de un depósito, `pagoBanqueteroId` dice de cuál; si no, sale
///    del saldo que le liberaron sus apartados vencidos o cancelados.
///
/// No lleva folio de la serie I: el folio numera el dinero que ENTRA. Si el pago
/// devuelto ya se había facturado, la nota de crédito (CFDI de egreso) se anota
/// en `notaCreditoUuid`.
model Devolucion {
  id               String          @id @default(cuid())
  quote            Quote?          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  quoteId          String?
  destino          PaymentDestino?
  banquetero       Banquetero?     @relation(fields: [banqueteroId], references: [id], onDelete: Restrict)
  banqueteroId     String?
  pagoBanquetero   PagoBanquetero? @relation(fields: [pagoBanqueteroId], references: [id], onDelete: Restrict)
  pagoBanqueteroId String?
  monto            Int
  metodo           PaymentMethod
  formas           Json?
  /// Cuándo SALIÓ el dinero.
  fecha            DateTime
  motivo           String
  referencia       String?
  notaCreditoUuid  String?
  registradoBy     User?           @relation("DevolucionRegistradaBy", fields: [registradoById], references: [id])
  registradoById   String?
  anuladoAt        DateTime?
  anuladoBy        User?           @relation("DevolucionAnuladaBy", fields: [anuladoById], references: [id])
  anuladoById      String?
  motivoAnulacion  String?
  createdAt        DateTime        @default(now())

  @@index([quoteId])
  @@index([banqueteroId])
  @@index([pagoBanqueteroId])
  @@index([fecha])
}
