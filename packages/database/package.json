{
  "name": "@hsa/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- prisma db seed",
    "seed:deploy": "tsx prisma/seed.ts",
    "backfill:fase5": "tsx prisma/backfill-fase5.ts",
    "backfill:fase6": "tsx prisma/backfill-fase6.ts",
    "backfill:fase7": "tsx prisma/backfill-fase7.ts",
    "backfill:fase8": "tsx prisma/backfill-fase8.ts",
    "backfill:fase9": "tsx prisma/backfill-fase9.ts",
    "backfill:fase11": "tsx prisma/backfill-fase11.ts",
    "backfill:fase12": "tsx prisma/backfill-fase12.ts",
    "backfill:fase13": "tsx prisma/backfill-fase13.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@node-rs/argon2": "^2.0.0", "@prisma/client": "^6.0.0" },
  "devDependencies": {
    "dotenv-cli": "^7.4.0",
    "prisma": "^6.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
