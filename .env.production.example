# Copia a .env (o define en EasyPanel) y ajusta los valores.

# Postgres (para el servicio postgres del compose)
POSTGRES_USER=hsa
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-fuerte
POSTGRES_DB=hsa

# La API se conecta a Postgres. Si usas el servicio del compose, host = postgres.
DATABASE_URL=postgresql://hsa:cambia-esto-por-una-contraseña-fuerte@postgres:5432/hsa?schema=public

# Secreto para firmar los JWT (mínimo 16 caracteres; usa algo largo y aleatorio).
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-aqui

# URL pública de la WEB (dominio del cliente). Se usa para CORS y para los links del QR.
PUBLIC_WEB_URL=https://hsacotizador.somossinergia.com

# 'lax' si web y API comparten dominio raíz (recomendado); 'none' si son dominios
# totalmente distintos (requiere COOKIE_SECURE=true, ya está arriba implícito en prod).
COOKIE_SAME_SITE=lax

# Puerto público del contenedor web (Opción A: Docker Compose en VPS).
WEB_PORT=8080

# Solo Opción B (EasyPanel, dominios separados): dominio público de la API, horneado
# en el build de la web. Déjalo vacío para la Opción A (mismo dominio vía nginx).
VITE_API_URL=https://hsapi.somossinergia.com
